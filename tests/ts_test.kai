import km2.ts

fn nodes(grammar: String, src: String) : Int / Ffi {
  let d = ts.parse(grammar, src)
  let n = if ts.parsed(d) { ts.count(d) } else { -1 }
  ts.free(d)
  n
}

fn captures(grammar: String, src: String, query: String) : Int / Ffi {
  let q = ts.query(grammar, query)
  let d = ts.parse(grammar, src)
  let n = ts.run(d, q)
  ts.free(d)
  ts.query_free(q)
  n
}

test "a rust source parses into a flattened tree" {
  assert nodes("rust", "fn f() {}\n") > 1
}

test "an elixir source parses into a flattened tree" {
  assert nodes("elixir", "defmodule M do\n  def f, do: 1\nend\n") > 1
}

test "an unknown grammar parses nothing" {
  assert nodes("cobol", "x") == (-1)
}

test "a file with a syntax error still parses" {
  assert nodes("kaikai", "fn (((\n") > 0
}

test "the shim evaluates #eq? on captured text" {
  let q = "((attribute name: (lower_identifier) @n) @a (#eq? @n \"doc\"))"
  assert captures("kaikai", "#[doc(\"x\")]\n#[constructor]\nfn f() : Int = 1\n", q) == 2
}

test "the shim evaluates #any-of? and #not-any-of? on captured text" {
  let src = "fn f(a: Int, b: String, c: Box) : Int = 1\n"
  let q = "((type_identifier) @t (#any-of? @t \"Int\" \"Box\"))"
  assert captures("kaikai", src, q) == 3
  let none = "((type_identifier) @t (#not-any-of? @t \"Int\" \"Box\"))"
  assert captures("kaikai", src, none) == 1
}

fn spans(d: ts.Doc, k: Int, acc: [(Int, Int, Int)]) : [(Int, Int, Int)] / Ffi =
  if k < 0 {
    acc
  } else {
    spans(d, k - 1, [
      (ts.capture_start_row(d, k), ts.capture_start_byte(d, k), ts.capture_end_byte(d, k)),
      ...acc
    ])
  }

fn ranges(grammar: String, src: String, query: String) : [(Int, Int, Int)] / Ffi {
  let q = ts.query(grammar, query)
  let d = ts.parse(grammar, src)
  let found = spans(d, ts.run(d, q) - 1, [])
  ts.free(d)
  ts.query_free(q)
  found
}

test "a capture carries its row and byte range without flattening the tree" {
  let src = "fn f() {}\nfn gh() {}\n"
  assert ranges("rust", src, "(function_item name: (identifier) @n)") == [(0, 3, 4), (1, 13, 15)]
}
