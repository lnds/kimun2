# Line classification as km pins it: Python, Elixir, Haskell, Fortran,
# Pascal and the languages of data, markup and tooling.

import km2.languages
import km2.languages.spec.{Spec}
import km2.lines

fn tally_with(spec: Spec, src: String) : (Int, Int, Int) {
  let t = lines.tally(spec, src)
  (t.blank, t.comment, t.code)
}

fn counts(path: String, src: String) : (Int, Int, Int) = match languages.detect(path, src) {
  None -> (-1, -1, -1)
  Some(spec) -> tally_with(spec, src)
}

fn py(src: String) : (Int, Int, Int) = counts("a.py", src)

# Python with triple-quoted strings as code, as km's own tests read it.
fn py_strings(src: String) : (Int, Int, Int) = match languages.by_name("a.py") {
  None -> (-1, -1, -1)
  Some(spec) -> tally_with(Spec { ...spec, triple_comments: false }, src)
}

test "python: triple-quoted strings as code" {
  assert py_strings("s = \"\"\"hello\nworld\"\"\"\n") == ((0, 0, 2))
  assert py_strings("s = '''hello\nworld'''\n") == ((0, 0, 2))
  assert py_strings("s = \"\"\"# not a comment\"\"\"\n") == ((0, 0, 1))
  assert py_strings("s = \"\"\"text\"\"\"; x = 1\n") == ((0, 0, 1))
  assert py_strings("s = '''text'''; x = 1\n") == ((0, 0, 1))
  assert py_strings("s = '# not a comment'\n") == ((0, 0, 1))
  assert py_strings("#!/usr/bin/env python3\n# comment\nprint('hi')\n") == ((0, 1, 2))
}

test "python: docstrings are comment, their blank lines blank" {
  let src =
    "\"\"\"Module docstring.\n\nExplains the module.\n\"\"\"\n\n\ndef add(a, b):\n    \"\"\"Add two numbers.\n\n    :param a: first\n    \"\"\"\n    return a + b\n\n\nclass Box:\n    '''A box.'''\n"
  assert py(src) == ((6, 7, 3))
  assert py("SQL = \"\"\"\nselect *\nfrom t\n\"\"\"\n") == ((0, 3, 1))
  assert py("\"\"\"a\"\"\" + \"\"\"b\"\"\"\n") == ((0, 0, 1))
  assert py("def f():\n    \"\"\"Don't\n    stop.\"\"\"\n    return 1\n") == ((0, 2, 2))
}

test "elixir: doc heredocs are comment, their blank lines included" {
  let src =
    "defmodule A do\n  @moduledoc \"\"\"\n  If it fails, it retries.\n\n  ## Examples\n  \"\"\"\n\n  @doc ~S\"\"\"\n  Runs it.\n  \"\"\"\n  def run, do: :ok\nend\n"
  assert counts("a.ex", src) == ((1, 8, 3))
  assert counts(
    "a.ex",
    "defmodule A do\n  @doc \"\"\"\n  It won't run twice.\n  \"\"\"\n  def run, do: :ok\nend\n"
  )
    == ((
      0,
      3,
      3
    ))
  assert counts(
    "a.ex",
    "defmodule A do\n  @doc \"\"\"\n  Say \"hi.\n  \"\"\"\n  def run, do: :ok\nend\n"
  )
    == ((
      0,
      3,
      3
    ))
}

test "elixir: other strings are code" {
  assert counts("a.ex", "@doc \"Runs it.\"\ndef run, do: :ok\n") == ((0, 0, 2))
  assert counts("a.ex", "@query \"\"\"\n# not a comment\nSELECT 1\n\"\"\"\n") == ((0, 0, 4))
  assert counts("a.exs", "@doc \"\"\"\nHelper.\n\"\"\"\ndef h, do: 1\n") == ((0, 3, 1))
}

fn hs(src: String) : (Int, Int, Int) = counts("a.hs", src)

test "haskell: pragmas are code, operators are no comment" {
  assert hs("{-# LANGUAGE OverloadedStrings #-}\n") == ((0, 0, 1))
  assert hs("x = y --> z\n") == ((0, 0, 1))
  assert hs("-- this is a comment\n") == ((0, 1, 0))
  assert hs("--- section\n") == ((0, 1, 0))
  assert hs("{- this is a comment -}\n") == ((0, 1, 0))
  assert hs("{-# LANGUAGE OverloadedStrings #-}\nmodule Main where\n") == ((0, 0, 2))
}

test "data, markup and tooling languages" {
  assert counts("a.json", "{\"key\": \"value\"}\n") == ((0, 0, 1))
  assert counts("a.bat", ":: comment\nrem comment\nREM comment\necho hello\n") == ((0, 3, 1))
  assert counts("a.y", "%token A\n/* c */\n// c\nrule: A ;\n") == ((0, 2, 2))
  assert counts("a.l", "%%\n/* c */\n[0-9]+ { return 1; }\n") == ((0, 1, 2))
  assert counts("CMakeLists.txt", "# c\nproject(x)\n") == ((0, 1, 1))
  assert counts("a.jq", "# c\ndef f: .;\n") == ((0, 1, 1))
  assert counts("a.eex", "<%# c %>\n<%= @x %>\n") == ((0, 1, 1))
  assert counts("a.heex", "<%!-- c\n--%>\n<% # c %>\n<div>{@x}</div>\n") == ((0, 3, 1))
  assert counts("a.rst", ".. note:: x\nText.\n") == ((0, 1, 1))
}

test "po files: translator comments and messages" {
  let src =
    "# translator comment\n#. extracted\n#: src/foo.ex:42\n#, fuzzy\nmsgid \"hello\"\nmsgstr \"hola\"\n"
  assert counts("es.po", src) == ((0, 4, 2))
  assert counts("es.po", "msgid \"\"\nmsgstr \"\"\n\nmsgid \"Save\"\nmsgstr \"Guardar\"\n")
    == ((1, 0, 4))
}

# HTML EEx as km's own tests read it: markup comments, single quotes.
fn heex_markup(src: String) : (Int, Int, Int) = match languages.by_name("a.heex") {
  None -> (-1, -1, -1)
  Some(spec) ->
    tally_with(Spec { ...spec, line_comments: [], block_comment: Some(("<!--", "-->")) }, src)
}

test "html eex with markup comments" {
  assert heex_markup("<!-- comment -->\n<div>hello</div>\n") == ((0, 1, 1))
  assert heex_markup("<!--\n  multi\n  line\n-->\n<p>code</p>\n") == ((0, 4, 1))
  assert heex_markup("<.live_component module={MyApp.Modal} id=\"modal\" />\n") == ((0, 0, 1))
}

test "fortran: fixed-form comments and directives" {
  assert counts(
    "a.f",
    "C     a comment\nc     another\n*     and another\n      X = 1\n      CALL F(X)\n"
  )
    == ((
      0,
      3,
      2
    ))
  assert counts(
    "m.f90",
    "module m\ncontains\n! a comment\nsubroutine s()\nend subroutine\nend module\n"
  )
    == ((
      0,
      1,
      5
    ))
  assert counts("a.F", "C$OMP PARALLEL\n!$omp end parallel\n      END\n") == ((0, 0, 3))
  assert counts("a.F90", "  !$omp parallel do\n  ! a comment\n") == ((0, 1, 1))
  assert counts("a.f95", "print *, 'hi! there'\nprint *, \"!\"\n") == ((0, 0, 2))
  assert counts("a.f", "c$$$  WRITE(*,*) X\nC$OMP PARALLEL\nc$acc kernels\nC$    X = 1\n")
    == ((0, 1, 3))
  assert counts("a.f90", "!$$ not a directive\n!$OMP DO\n") == ((0, 1, 1))
}

test "pascal: two block comments, directives, no escapes" {
  let src =
    "{ a brace comment (* with the other inside\n  still open }\n(* the other\n   { a brace } still open\n*)\nbegin\nend.\n"
  assert counts("a.pas", src) == ((0, 5, 2))
  assert counts("a.dpr", "{$mode objfpc}{$H+}\n{ comment }\n// another\n") == ((0, 2, 1))
  assert counts("a.pas", "WriteLn('{ not a comment');\nX := 1;\n") == ((0, 0, 2))
}
