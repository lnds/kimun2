import collections.map
import km2.age
import km2.age.{Thresholds, AgeActive, AgeStale, AgeFrozen}
import km2.authors
import km2.churn
import km2.churn.{ChurnLow, ChurnMedium, ChurnHigh}
import km2.generated
import km2.git.{Hunk}
import km2.history.{Frequency}
import km2.history_report

const DAY : Int = 86400

const MONTH : Int = 30 * 86400

fn f(commits: Int) : Frequency = Frequency { commits: commits, first: 0, last: 0 }

test "churn is commits per month over one month at least" {
  assert churn.classify("a", "Rust", f(3), 0, 0).rate == 3.0
  assert churn.classify("a", "Rust", f(3), 0, 0).level == ChurnMedium
  assert churn.classify("a", "Rust", f(10), 0, 2 * MONTH).level == ChurnHigh
  assert churn.classify("a", "Rust", f(1), 0, 2 * MONTH).level == ChurnLow
  assert churn.classify("a", "Rust", f(4), 0, MONTH).level == ChurnMedium
}

test "age is whole days, active below the first threshold and frozen from the second" {
  let t = Thresholds { active: 90, frozen: 365 }
  assert age.classify("a", "Rust", 0, 89 * DAY + 5, t).status == AgeActive
  assert age.classify("a", "Rust", 0, 90 * DAY, t).status == AgeStale
  assert age.classify("a", "Rust", 0, 365 * DAY, t).status == AgeFrozen
  assert age.classify("a", "Rust", 100, 0, t).days == 0
}

test "a day is printed in UTC" {
  assert history_report.day(0) == "1970-01-01"
  assert history_report.day(1772456652) == "2026-03-02"
  assert history_report.day(951782400) == "2000-02-29"
}

test "since counts back from now in days, months of 30 days, or years of 365" {
  assert history_report.since("2d", 10 * DAY) == Ok(8 * DAY)
  assert history_report.since(" 1m ", 100 * DAY) == Ok(70 * DAY)
  assert history_report.since("1y", 400 * DAY) == Ok(35 * DAY)
  assert history_report.since("", 0) == Err("empty --since value")
  assert history_report.since("6", 0)
    == Err("invalid --since value: \"6\" (no unit, expected e.g. 6m, 1y, 30d)")
  assert history_report.since("6x", 0)
    == Err("unknown unit in --since: \"6x\" (use d, m, or y)")
  assert history_report.since("2y", DAY) == Err("--since value goes before Unix epoch")
}

test "a table lists twenty rows by default, JSON every row unless told" {
  assert history_report.shown_count("table", None, 50) == 20
  assert history_report.shown_count("json", None, 50) == 50
  assert history_report.shown_count("json", Some(5), 50) == 5
  assert history_report.shown_count("short", Some(5), 50) == 50
}

test "paths sort component by component" {
  let split = (p: String) => string.split(p, "/")
  assert history_report.by_components(split("src/html/base.css"), split("src/html.rs")) < 0
  assert history_report.by_components(split("a/b"), split("a")) > 0
}

fn hunk(author: String, email: String, time: Int, lines: Int) : Hunk =
  Hunk { author: author, email: email, time: time, committed: time, start_line: 1, lines: lines }

test "a file's authors: most lines, then the newest, joined by email without case" {
  let blames = authors.per_author([
    hunk("Ana", "ana@x.org", 10, 3),
    hunk("Bo", "bo@x.org", 20, 3),
    hunk("Ana B.", "ANA@x.org", 5, 1)
  ])
  assert (blames | .name) == ["Ana", "Bo"]
  assert (blames | .lines) == [4, 3]
}

test "the first author of a file owns it; the log's newest commit sets the last activity" {
  let one = authors.per_author([hunk("Ana", "ana@x.org", 10, 3), hunk("Bo", "bo@x.org", 20, 1)])
  let two = authors.per_author([hunk("Bo", "bo@x.org", 30, 5)])
  let summary = authors.summaries([("Rust", one), ("C", two)], map.put(%{}, "bo@x.org", 99))
  assert (summary | .name) == ["Bo", "Ana"]
  assert (summary | .owned) == [1, 1]
  assert (summary | .last) == [99, 10]
}

test "generated files by name and by text" {
  assert generated.by_name("a/Cargo.lock")
  assert generated.by_name("dist/app.min.js")
  assert generated.by_name("x.generated.cs")
  assert not generated.by_name("src/main.rs")
  assert generated.by_text("// Code generated by protoc. DO NOT EDIT.\npackage x\n")
  assert generated.by_text("x\n//# sourceMappingURL=app.js.map\n")
  assert not generated.by_text("fn main() {}\n")
  let late = string.repeat("\n", 20) ++ "// @generated\n"
  assert not generated.by_text(late)
}
