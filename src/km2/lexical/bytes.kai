# Byte-level reading of a line: what the lexical classifier is built on.

#[doc("The byte of `s` at offset `i`, or -1 outside it.")]
pub fn byte(s: String, i: Int) : Int = string.string_byte_at_int(s, i)

fn matches_from(s: String, i: Int, pat: String, j: Int, n: Int) : Bool =
  if j == n {
    true
  } else if byte(s, i + j) != byte(pat, j) {
    false
  } else {
    matches_from(s, i, pat, j + 1, n)
  }

#[doc("Whether `pat` occurs in `s` at byte `i`.")]
pub fn at(s: String, i: Int, pat: String) : Bool =
  matches_from(s, i, pat, 0, string.byte_length(pat))

fn lower(b: Int) : Int = if b >= 65 and b <= 90 { b + 32 } else { b }

fn matches_folded(s: String, i: Int, pat: String, j: Int, n: Int) : Bool =
  if j == n {
    true
  } else if byte(s, i + j) < 0 or lower(byte(s, i + j)) != lower(byte(pat, j)) {
    false
  } else {
    matches_folded(s, i, pat, j + 1, n)
  }

#[doc("Whether `pat` occurs in `s` at byte `i`, ignoring ASCII case.")]
pub fn at_folded(s: String, i: Int, pat: String) : Bool =
  matches_folded(s, i, pat, 0, string.byte_length(pat))

#[doc("Whether a byte is ASCII whitespace as km tests it per byte: space, tab, LF, FF, CR, never VT.")]
pub fn is_space(b: Int) : Bool = b == 32 or b == 9 or b == 10 or b == 12 or b == 13

#[doc("Whether a byte is an ASCII letter.")]
pub fn is_alpha(b: Int) : Bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122)

#[doc("Whether a byte is an ASCII letter, digit or underscore.")]
pub fn is_word(b: Int) : Bool = is_alpha(b) or (b >= 48 and b <= 57) or b == 95

#[doc("Whether byte `b` is one of the bytes of `set`.")]
pub fn one_of(set: String, b: Int) : Bool = b >= 0 and member(set, b, 0, string.byte_length(set))

fn member(set: String, b: Int, i: Int, n: Int) : Bool =
  if i >= n { false } else if byte(set, i) == b { true } else { member(set, b, i + 1, n) }

#[doc("How many bytes equal to `b` follow from `i`, plus `n`.")]
pub fn count_run(s: String, i: Int, b: Int, n: Int) : Int =
  if byte(s, i) == b { count_run(s, i + 1, b, n + 1) } else { n }

#[doc("How many word bytes follow from `i`, plus `n`.")]
pub fn word_len(s: String, i: Int, n: Int) : Int =
  if is_word(byte(s, i)) { word_len(s, i + 1, n + 1) } else { n }

#[doc("How many ASCII letters follow from `i`, plus `n`.")]
pub fn alpha_len(s: String, i: Int, n: Int) : Int =
  if is_alpha(byte(s, i)) { alpha_len(s, i + 1, n + 1) } else { n }

#[doc("The first offset from `i` below `n` holding byte `a`, `b` or `c`, or `n`.")]
pub fn skip_until(s: String, i: Int, n: Int, a: Int, b: Int, c: Int) : Int =
  if i >= n {
    i
  } else {
    let x = byte(s, i)
    if x == a or x == b or x == c { i } else { skip_until(s, i + 1, n, a, b, c) }
  }

#[doc("The first offset from `i` where `pat` occurs in `s`, or -1.")]
pub fn find(s: String, i: Int, pat: String) : Int = if i + string.byte_length(pat)
  > string.byte_length(
    s
  ) {
  -1
} else if at(s, i, pat) {
  i
} else {
  find(s, i + 1, pat)
}

#[doc("Whether an interpolation opens (`#` and `{`) between bytes `from` and `to`.")]
pub fn holds_interpolation(s: String, from: Int, to: Int) : Bool =
  if from + 2 > to {
    false
  } else if byte(s, from) == 35 and byte(s, from + 1) == 123 {
    true
  } else {
    holds_interpolation(s, from + 1, to)
  }

fn has_nul(s: String, i: Int, n: Int) : Bool =
  if i >= n { false } else if byte(s, i) == 0 { true } else { has_nul(s, i + 1, n) }

#[doc("Whether a source is binary: a NUL byte among its first 512, as km tells.")]
pub fn is_binary(src: String) : Bool {
  let n = string.byte_length(src)
  has_nul(src, 0, if n < 512 { n } else { 512 })
}
