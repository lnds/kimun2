# The `loc` command line: km's arguments and options, `--list-excluded`
# and `--by-author`.

import ahu.cli
import fs.file
import collections.map
import collections.set
import path
import km2.config
import km2.config.{Config}
import km2.git
import km2.git.{Repo, Hunk}
import km2.glob
import km2.glob.{Glob}
import km2.kinds
import km2.kinds.{Kind, Selection, Declared, KCode, KDocs, KInfra, KData}
import km2.languages
import km2.languages.spec.{Spec}
import km2.lines
import km2.lines.{LineKind, Blank, Comment, Code}
import km2.loc
import km2.loc.{Options}
import km2.loc_report
import km2.loc_report.{Counts, Author}
import km2.rust_tests
import km2.selection
import km2.selection.{Filter}
import km2.sources
import km2.sources.{Source}
import km2.walk

const FORMATS : [String] = ["table", "json", "short", "terse", "github", "codeclimate", "gitlab"]

fn compiled(patterns: [String], warn: (String, String) -> String) : [Glob] / Stderr =
  patterns
    || (p => match glob.compile(p, false) {
      Ok(g) -> [g]
      Err(e) -> {
        Stderr.eprint(warn(p, e))
        []
      }
    })

fn exclude_warning(p: String, e: String) : String = "warning: invalid glob '#{p}': #{e}"

fn kind_warning(p: String, e: String) : String = "warning: invalid glob '#{p}' in [kinds]: #{e}"

fn declared(c: Config) : [Declared] / Stderr =
  [(KCode, c.kinds.code), (KDocs, c.kinds.docs), (KInfra, c.kinds.infra), (KData, c.kinds.data)]
    || (d => {
      let (k, patterns) = d
      if patterns == [] {
        []
      } else {
        [Declared { kind: k, globs: compiled(patterns, kind_warning) }]
      }
    })

fn chosen_kinds(values: [String]) : Result[Option[[Kind]], String] =
  if values == [] {
    Ok(None)
  } else {
    let parts = values || (v => string.split(v, ","))
    match list.find(parts, p => kinds.parse(p) == None) {
      Some(bad) -> Err(
        "invalid value '#{bad}' for '--kind <KIND>' [possible values: code, docs, infra, data, all]"
      )
      None ->
        Ok(Some(kinds.ALL |? (k => list.any(parts, p => list.contains(kinds.parse(p) ?? [], k)))))
    }
  }

fn options(c: cli.Context, cfg: Config) : Result[Options, String] / Stderr {
  let format = cli.text(c, "format") ?? "table"
  let include = cli.texts(c, "include-ext")
  let exclude = cli.texts(c, "exclude-ext")
  let chosen = chosen_kinds(cli.texts(c, "kind"))!
  let filter = Filter {
    include_ext: selection.normalized(include),
    exclude_ext: selection.normalized(exclude ++ cfg.exclude_extensions),
    exclude_dirs: cli.texts(c, "exclude-dir") ++ cfg.exclude_dirs,
    globs: compiled(cli.texts(c, "exclude") ++ cfg.exclude_patterns, exclude_warning)
  }
  Ok(Options {
    root: cli.argument(c, "PATH") ?? ".",
    format: format,
    exclude_tests: not cli.boolean(c, "include-tests"),
    filter: filter,
    selection: Selection { chosen: chosen, declared: declared(cfg) },
    verbose: cli.boolean(c, "verbose"),
    list_excluded: cli.boolean(c, "list-excluded"),
    by_author: cli.boolean(c, "by-author")
  })
}

# `--list-excluded`: the files the filters leave out, each with its reasons.

fn ancestor_reason(o: Options, p: String) : [String] {
  let dirs = string.split(path.dirname(p), "/") |? (d => d != "" and d != "." and d != "..")
  match list.find(
    dirs,
    d => list.contains(o.filter.exclude_dirs, d)
      or (o.exclude_tests and selection.is_non_production_dir(d))
  ) {
    None -> []
    Some(d) ->
      if list.contains(o.filter.exclude_dirs, d) {
        ["directory"]
      } else if selection.is_test_dir(d) {
        ["test directory"]
      } else {
        ["example or benchmark directory"]
      }
  }
}

fn kind_reason(o: Options, p: String) : [String] / File = match sources.language(p) {
  None -> []
  Some(spec) -> {
    let k = kinds.of(o.selection, p, selection.relative(o.root, p), spec.name, spec.is_code)
    if kinds.reads(o.selection, k) { [] } else { ["kind #{kinds.name(k)}"] }
  }
}

fn reasons(o: Options, modules: [String], p: String) : [String] / File =
  (if o.exclude_tests and selection.is_test_file(p) { ["test file"] } else { [] })
    ++ (if selection.excludes_by_extension(o.filter, p) { ["extension"] } else { [] })
    ++ ancestor_reason(o, p)
    ++ (if selection.excludes_by_glob(o.filter, o.root, p) { ["glob"] } else { [] })
    ++ (if rust_tests.in_test_module(p, modules) { ["test module"] } else { [] })
    ++ kind_reason(o, p)

fn list_excluded(o: Options) : String / File + Env {
  let everything = walk.files(o.root, false, selection.EMPTY).files
  let modules = if o.exclude_tests {
    sources.test_modules(
      sources.files(o.root, false, selection.EMPTY, Selection { chosen: None, declared: [] }).sources
    )
  } else {
    []
  }
  let lines = everything
    || (p => match reasons(o, modules, p) {
      [] -> []
      rs -> ["#{selection.relative(o.root, p)} (#{string.join(rs, ", ")})"]
    })
  string.join([...lines, "", "#{list.length(lines)} file(s) excluded"], "\n")
}

# `--by-author`: each line classified from the working tree and given to
# the author git blames for it at HEAD.

type Owner = { name: String, counts: Counts, files: Set[String] }

fn add_line(c: Counts, k: LineKind) : Counts = match k {
  Blank -> Counts { ...c, blank: c.blank + 1 }
  Comment -> Counts { ...c, comment: c.comment + 1 }
  Code -> Counts { ...c, code: c.code + 1 }
}

fn attribute(owners: Map[String, Owner], kinds_of: [LineKind], file_key: String, h: Hunk) : Map[
  String,
  Owner
] {
  let key = git.identity(h.author, h.email)
  let before =
    map.get(owners, key) ?? Owner { name: h.author, counts: loc_report.EMPTY, files: set.empty() }
  let counted = list.drop(kinds_of, h.start_line - 1)
    |> list.take(h.lines)
    |> list.foldl(before.counts, add_line)
  owners
    |> map.put(key, Owner {
      name: h.author,
      counts: counted,
      files: set.insert(before.files, file_key)
    })
}

type Blamed = { owners: Map[String, Owner], seen: Set[Int], warned: Bool }

fn blame_file(repo: Repo, root: String, b: Blamed, s: Source) : Blamed / File + Process + Stderr =
  match file.read(s.path) {
    Err(_) -> b
    Ok(src) -> {
      let h = loc.content_hash(src)
      if set.contains(b.seen, h) {
        b
      } else {
        let rel = selection.relative(root, s.path)
        let key = if repo.prefix == "" { rel } else { path.join(repo.prefix, rel) }
        let (hunks, fell_back) = git.blame(repo, key)
        if fell_back and (not b.warned) {
          Stderr.eprint(
            "warning: git blame cannot read .git-blame-ignore-revs; blaming without it"
          )
        }
        let seen = set.insert(b.seen, h)
        match hunks {
          None -> Blamed { ...b, seen: seen, warned: b.warned or fell_back }
          Some(hs) -> {
            let kinds_of = lines.kinds(languages.refine(s.path, s.spec, src), src)
            let owners = hs |> list.foldl(b.owners, (m, hunk) => attribute(m, kinds_of, key, hunk))
            Blamed { owners: owners, seen: seen, warned: b.warned or fell_back }
          }
        }
      }
    }
  }

const SHALLOW : String =
  "warning: shallow clone: the history stops at the commits fetched, so commit counts, authors and ages read from it are short (git fetch --unshallow)"

fn by_author(o: Options) : Result[String, String] / File + Env + Process + Stderr {
  let repo = git.discover(o.root)!
  if git.is_shallow(repo) {
    Stderr.eprint(SHALLOW)
  }
  let found = sources.files(o.root, o.exclude_tests, o.filter, o.selection)
  loc.warn_unreadable(o.root, found.errors)
  let files = found.sources
  let start = Blamed { owners: %{}, seen: set.empty(), warned: false }
  let blamed = files |> list.foldl(start, (b, s) => blame_file(repo, o.root, b, s))
  let authors = map.to_pairs(blamed.owners)
    | (p => Author {
      name: p.snd.name,
      identity: p.fst,
      counts: Counts { ...p.snd.counts, files: list.length(set.to_list(p.snd.files)) }
    })
    |> loc_report.sort_authors
  if authors == [] {
    Ok(if o.format == "json" { loc_report.EMPTY_AUTHORS_JSON } else { loc_report.NOTHING })
  } else {
    match o.format {
      "json" -> Ok(loc_report.authors_json(authors))
      "short" -> Ok(loc_report.authors_short(authors))
      "terse" -> Ok(loc_report.authors_terse(authors))
      "table" -> Ok(loc_report.authors_table(authors))
      _ -> Err(loc_report.CI_FORMAT_ONLY)
    }
  }
}

fn run_loc(c: cli.Context) : Result[Unit, String] / File + Env + Process + Stdout + Stderr + Clock {
  let o = options(c, config.load())!
  let out = if o.list_excluded {
    list_excluded(o)
  } else if o.by_author {
    by_author(o)!
  } else {
    loc.run(o)!
  }
  Stdout.print(out)
  Ok(())
}

#[doc("The `loc` command, with `km loc`'s arguments and options.")]
pub fn command() : cli.Command[File + Env + Process + Stdout + Stderr + Clock] =
  cli.command("loc", "Count lines of code (blank, comment, code) by language", run_loc)
    |> cli.with_argument(
      cli.argument_with_default("PATH", "Directory to analyze (default: current directory)", ".")
    )
    |> cli.with_option(
      cli.text_option_with_default(
        "format",
        "Output format",
        "table"
      )
        |> cli.value_name("FORMAT")
        |> cli.choices(FORMATS)
    )
    |> cli.with_option(
      cli.boolean_option(
        "include-tests",
        "Include tests, examples and benchmarks in analysis (excluded by default)"
      )
    )
    |> cli.with_option(
      cli.text_list_option(
        "include-ext",
        "Only include files with these extensions (case-insensitive, leading dot optional). Repeatable"
      )
        |> cli.value_name("EXT")
        |> cli.conflicts_with("exclude-ext")
    )
    |> cli.with_option(
      cli.text_list_option(
        "exclude-ext",
        "Exclude files by extension, case-insensitive (leading dot optional). Repeatable"
      )
        |> cli.value_name("EXT")
    )
    |> cli.with_option(
      cli.text_list_option(
        "exclude-dir",
        "Exclude directories by exact name (case-sensitive), at any depth. Repeatable"
      )
        |> cli.value_name("DIR")
    )
    |> cli.with_option(
      cli.text_list_option(
        "exclude",
        "Exclude files matching a glob pattern against the path relative to the analysis root. Repeatable"
      )
        |> cli.short("E")
        |> cli.value_name("PATTERN")
    )
    |> cli.with_option(
      cli.text_list_option(
        "kind",
        "Read only files of these kinds: code, docs, infra, data or all. Repeatable or comma-separated"
      )
        |> cli.value_name("KIND")
    )
    |> cli.with_option(
      cli.boolean_option(
        "list-excluded",
        "Print files that would be excluded by the current filter and exit"
      )
    )
    |> cli.with_option(
      cli.boolean_option(
        "verbose",
        "Show summary stats (files read, unique, ignored, elapsed time)"
      )
        |> cli.short("v")
    )
    |> cli.with_option(
      cli.boolean_option(
        "by-author",
        "Break down lines of code by git author (requires a git repository)"
      )
    )
