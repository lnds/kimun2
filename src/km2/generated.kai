# Generated files, as km tells them: by name, by a marker in their first
# lines, or as bundler output (a source map beside them or named at their
# end). The metrics of code leave them out.

import fs.file
import km2.selection

const LOCK_FILES : [String] = [
  "Cargo.lock",
  "package-lock.json",
  "yarn.lock",
  "pnpm-lock.yaml",
  "Gemfile.lock",
  "poetry.lock",
  "uv.lock",
  "composer.lock",
  "Pipfile.lock",
  "mix.lock",
  "go.sum"
]

const SUFFIXES : [String] = [".min.js", ".min.css", ".bundle.js", ".pb.go", "_pb2.py"]

#[doc("Whether a file's name says it is generated: a lock file, minified or bundled output, or generated code.")]
pub fn by_name(p: String) : Bool {
  let name = selection.file_name(p)
  list.contains(LOCK_FILES, name)
    or list.any(SUFFIXES, s => string.ends_with(name, s))
    or string.contains(name, ".generated.")
}

const HEAD_LINES : Int = 20

const TAIL_BYTES : Int = 512

#[doc("Whether a line of a file's head says the file is generated.")]
pub fn is_marker(line: String) : Bool {
  let l = string.to_lower_unicode(line)
  (string.contains(l, "generated") and string.contains(l, "do not edit"))
    or string.contains(l, "@generated")
    or string.contains(l, "<auto-generated")
    or string.contains(l, "a bison parser, made by gnu bison")
    or string.contains(l, "a lexical scanner generated by flex")
    or string.contains(l, "__defprop = object.defineproperty")
}

const HEAD_BYTES : Int = 65536

# The first lines of a text, split from a prefix when the prefix holds them
# all, from the whole text when its first lines are longer.
fn head(src: String, n: Int) : [String] {
  let prefix = if n > HEAD_BYTES {
    string.slice(src, 0, string.floor_char_boundary(src, HEAD_BYTES))
  } else {
    src
  }
  let lines = string.split(prefix, "\n")
  if list.length(lines) > HEAD_LINES or n <= HEAD_BYTES {
    list.take(lines, HEAD_LINES)
  } else {
    list.take(string.split(src, "\n"), HEAD_LINES)
  }
}

#[doc("Whether a file's text says it is generated: a marker in its first lines, or a source map named in its last bytes.")]
pub fn by_text(src: String) : Bool {
  let n = string.byte_length(src)
  let from = if n > TAIL_BYTES { string.ceil_char_boundary(src, n - TAIL_BYTES) } else { 0 }
  let tail = string.slice(src, from, n - from)
  list.any(head(src, n), is_marker)
    or string.contains(tail, "sourceMappingURL=")
}

#[doc("Whether a file is generated: by its name, a source map beside it, or its text; a file that cannot be read is judged by its name.")]
pub fn is_generated(p: String) : Bool / File =
  by_name(p)
    or file.exists(p ++ ".map")
    or (match file.read(p) {
      Ok(src) -> by_text(src)
      Err(_) -> false
    })
