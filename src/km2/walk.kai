# The files a command reads under a root, in km's order: depth first, each
# directory's entries by name byte by byte, with ignore files, `.git`,
# tests and the user's exclusions applied. A directory left out is not
# read, and the root itself is never filtered.

import fs.dir
import fs.dir.{DirEntry, EntryDir, EntryFile}
import fs.file
import path
import km2.ignores
import km2.ignores.{Stack}
import km2.selection
import km2.selection.{Filter}

fn strip_trailing_slash(p: String) : String =
  if p != "/" and string.ends_with(p, "/") {
    strip_trailing_slash(string.slice(p, 0, string.byte_length(p) - 1))
  } else {
    p
  }

fn normalize(parts: [String], acc: [String]) : [String] = match parts {
  [] -> list.reverse(acc)
  ["", ...rest] -> normalize(rest, acc)
  [".", ...rest] -> normalize(rest, acc)
  ["..", ...rest] -> normalize(rest, list.drop(acc, 1))
  [p, ...rest] -> normalize(rest, [p, ...acc])
}

#[doc("A path made absolute against the working directory, with `.` and `..` resolved by name.")]
pub fn absolute(p: String) : String / File {
  let full = if path.is_absolute(p) { p } else { path.join(ok(dir.current()) ?? "/", p) }
  "/" ++ string.join(normalize(string.split(full, "/"), []), "/")
}

#[doc("A directory a walk could not read, and the reason the OS gave.")]
pub type Unreadable = { dir: String, reason: String }

#[doc("What a walk found: the files it keeps and the directories it could not read, in walk order.")]
pub type Walked = { files: [String], errors: [Unreadable] }

type Walk = { root: String, filter: Filter, exclude_tests: Bool }

fn by_name(a: DirEntry, b: DirEntry) : Int =
  if a.name < b.name { -1 } else if b.name < a.name { 1 } else { 0 }

fn visit_dir(w: Walk, d: String, stack: Stack, acc: Walked) : Walked / File =
  match dir.list_entries(d) {
    Err(e) -> {
      let reason = string.drop_prefix(e, d ++ ": ") ?? e
      Walked { ...acc, errors: [Unreadable { dir: d, reason: reason }, ...acc.errors] }
    }
    Ok(entries) ->
      list.sort_by(entries, by_name) |> list.foldl(acc, (a, e) => visit(w, d, stack, a, e))
  }

# Symbolic links and special files are never read.
fn visit(w: Walk, parent: String, stack: Stack, acc: Walked, e: DirEntry) : Walked / File {
  let p = parent ++ "/" ++ e.name
  match e.kind {
    EntryDir ->
      if selection.excludes_dir(w.filter, w.exclude_tests, e.name)
        or ignores.ignored(stack, p, true) {
        acc
      } else {
        visit_dir(w, p, ignores.enter(stack, p), acc)
      }
    EntryFile ->
      if ignores.ignored(stack, p, false)
        or selection.excludes_file(w.filter, w.root, w.exclude_tests, p) {
        acc
      } else {
        Walked { ...acc, files: [p, ...acc.files] }
      }
    _ -> acc
  }
}

fn is_file(p: String) : Bool / File = match file.metadata(p) {
  Ok(m) -> m.is_file
  Err(_) -> false
}

#[doc("The files under `root` a command reads, in walk order; a root that is a file is read whatever the filters say.")]
pub fn files(root: String, exclude_tests: Bool, filter: Filter) : Walked / File + Env {
  let r = strip_trailing_slash(root)
  if is_file(r) {
    Walked { files: [r], errors: [] }
  } else {
    let w = Walk { root: r, filter: filter, exclude_tests: exclude_tests }
    let found = visit_dir(w, r, ignores.at_root(r, absolute(r)), Walked { files: [], errors: [] })
    Walked { files: list.reverse(found.files), errors: list.reverse(found.errors) }
  }
}
