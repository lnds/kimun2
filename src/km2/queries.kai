# Generated by scripts/gen-queries.sh from queries/; do not edit.

#[doc("The query source for a grammar and a query name, or the empty string.")]
pub fn source(grammar: String, name: String) : String = match (grammar, name) {
  ("elixir", "cycom") ->
    """
    ; Cyclomatic complexity, as km counts it: a branch per decision construct
    ; and boolean operator, and one per clause arrow but the catch-all and
    ; the arrow of an anonymous function opened on its line. Each clause of
    ; a `def` is a function.
    ((call
      target: (identifier) @_def
      (arguments
        [(call target: (identifier) @name)
         (identifier) @name
         (binary_operator left: [(call target: (identifier) @name) (identifier) @name])])) @function
      (#any-of? @_def "def" "defp" "defmacro" "defmacrop"))
    
    ((call target: (identifier) @branch)
      (#any-of? @branch "if" "unless" "with" "for"))
    
    ["and" "or" "&&" "||" "rescue" "catch"] @branch
    
    "->" @arrow
    
    ((stab_clause left: (arguments . (identifier) @_catch_all .) "->" @unarrow)
      (#eq? @_catch_all "_"))
    
    (anonymous_function "fn" @lambda)
    
    ; A `quote` is code for the caller to compile: it counts in no function
    ; around it, and each `def` inside it is a function of its own.
    ((call target: (identifier) @_quote) @scope
      (#eq? @_quote "quote"))
    
    ; Documentation is no code, whatever it interpolates.
    ((unary_operator operand: (call target: (identifier) @_attr)) @ignore
      (#any-of? @_attr "doc" "moduledoc" "typedoc"))
    
    ; Top-level nodes: a file whose only ones are comments has no code.
    (source (_) @item)
    
    (source (comment) @comment)
    """
  ("kaikai", "cycom") ->
    """
    ; Cyclomatic complexity, as km counts it: a branch per decision keyword,
    ; boolean operator and `??`. A `test` block counts with the code outside
    ; functions.
    (function_declaration name: (lower_identifier) @name) @function
    
    ["if" "match" "case" "when" "handle" "with" "and" "or" "??"] @branch
    
    ; Top-level nodes: a file whose only ones are comments has no code.
    (source_file (_) @item)
    
    (source_file (line_comment) @comment)
    
    ; A `#[doc]` attribute is documentation, as a comment is.
    ((source_file (attribute name: (lower_identifier) @_doc) @comment)
      (#eq? @_doc "doc"))
    """
  ("rust", "cycom") ->
    """
    ; Cyclomatic complexity, as km counts it: a branch per decision keyword
    ; and short-circuit operator, macro arguments included, and one per match
    ; arm but the catch-all. Nested functions and closures count in the
    ; function that holds them.
    (function_item name: (identifier) @name) @function
    
    ["if" "while" "for" "loop" "&&" "||" "=>"] @branch
    
    ; `impl Trait for Type` names a type; `for` there is no loop.
    (impl_item "for" @unbranch)
    
    ((match_arm pattern: (match_pattern) @unbranch)
      (#eq? @unbranch "_"))
    
    ; Top-level nodes: a file whose only ones are comments has no code.
    (source_file (_) @item)
    
    (source_file [(line_comment) (block_comment)] @comment)
    """
  _ -> ""
}

#[doc("Every (grammar, query name) pair with a source.")]
pub const ALL : [(String, String)] = [
  ("elixir", "cycom"),
  ("kaikai", "cycom"),
  ("rust", "cycom")
]
