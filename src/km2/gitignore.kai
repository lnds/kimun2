# Ignore files (`.gitignore`, `.ignore`, `.git/info/exclude`, the global
# excludes file), read and matched as the walk km is built on reads them.

import collections.map
import km2.glob
import km2.glob.{Glob, WholePath, LastComponent, Extension, NoKey}

#[doc("One pattern line: its glob, whether `!` re-includes, whether it matches directories only.")]
pub type Rule = { pattern: Glob, whitelist: Bool, only_dir: Bool }

# A rule and its line order: of the rules that match, the latest decides.
type Indexed = { index: Int, rule: Rule }

#[doc("The rules of one ignore file, matched relative to the directory `root`: those one string decides, by that string, and the rest last first.")]
pub type Matcher = {
  root: String,
  priv whole: Map[String, [Indexed]],
  priv last: Map[String, [Indexed]],
  priv extensions: Map[String, [Indexed]],
  priv others: [Indexed],
  priv general: Bool,
  priv size: Int
}

#[doc("What an ignore file says about a path.")]
pub type Verdict = Ignored | Whitelisted | Unmatched

#[doc("A matcher with no rules.")]
pub fn empty(root: String) : Matcher =
  Matcher {
    root: root,
    whole: %{},
    last: %{},
    extensions: %{},
    others: [],
    general: false,
    size: 0
  }

fn file_under(m: Map[String, [Indexed]], k: String, i: Indexed) : Map[String, [Indexed]] =
  map.put(m, k, [i, ...map.get(m, k) ?? []])

fn add(m: Matcher, i: Indexed) : Matcher = match glob.key(i.rule.pattern) {
  WholePath(k) -> Matcher { ...m, whole: file_under(m.whole, k, i) }
  LastComponent(k) -> Matcher { ...m, last: file_under(m.last, k, i) }
  Extension(k) -> Matcher { ...m, extensions: file_under(m.extensions, k, i) }
  NoKey -> Matcher {
    ...m,
    others: [i, ...m.others],
    general: m.general or glob.is_general(i.rule.pattern)
  }
}

fn has_doublestar_prefix(p: String) : Bool = string.starts_with(p, "**/") or p == "**"

fn drop_first(s: String) : String = string.slice(s, 1, string.byte_length(s) - 1)

fn drop_last(s: String) : String = string.slice(s, 0, string.byte_length(s) - 1)

# The line with its markers taken off: the glob text, whether it is
# anchored, whether it re-includes.
fn markers(line: String) : (String, Bool, Bool) =
  if string.starts_with(line, "\\!") or string.starts_with(line, "\\#") {
    let rest = drop_first(line)
    (rest, string.starts_with(rest, "/"), false)
  } else {
    let whitelist = string.starts_with(line, "!")
    let rest = if whitelist { drop_first(line) } else { line }
    if string.starts_with(rest, "/") {
      (drop_first(rest), true, whitelist)
    } else {
      (rest, false, whitelist)
    }
  }

# A trailing slash makes the rule match directories only; an escaped one
# keeps no backslash.
fn directory_only(text: String) : (String, Bool) =
  if not string.ends_with(text, "/") {
    (text, false)
  } else {
    let body = drop_last(text)
    (if string.ends_with(body, "\\") { drop_last(body) } else { body }, true)
  }

# A pattern with no slash matches at any depth; a trailing `/**` matches
# inside its directory only.
fn glob_text(body: String, anchored: Bool) : String {
  let floating =
    (not anchored) and (not string.contains(body, "/")) and (not has_doublestar_prefix(body))
  let anywhere = if floating { "**/" ++ body } else { body }
  if string.ends_with(anywhere, "/**") { anywhere ++ "/*" } else { anywhere }
}

fn rule_of(raw: String) : Option[Rule] {
  let line = if string.ends_with(raw, "\\ ") { raw } else { string.trim_right(raw) }
  if line == "" or string.starts_with(line, "#") {
    None
  } else {
    let (text, anchored, whitelist) = markers(line)
    let (body, only_dir) = directory_only(text)
    ok(glob.compile(glob_text(body, anchored), true))
      |> option.map(g => Rule { pattern: g, whitelist: whitelist, only_dir: only_dir })
  }
}

fn rules_of(line: String) : [Rule] = match rule_of(line) {
  Some(r) -> [r]
  None -> []
}

#[doc("Reads an ignore file's text; lines that do not compile are skipped, as the walk km uses skips them.")]
pub fn parse(root: String, text: String) : Matcher {
  let rules = string.lines(text) || (l => rules_of(string.drop_suffix(l, "\r") ?? l))
  let indexed = list.map_indexed(rules, (i, r) => Indexed { index: i, rule: r })
  Matcher { ...indexed |> list.foldl(empty(root), add), size: list.length(rules) }
}

fn strip_dot_slash(p: String) : String = string.drop_prefix(p, "./") ?? p

# The path relative to the matcher's directory.
fn relative(m: Matcher, path: String) : String {
  let p = strip_dot_slash(path)
  let root = strip_dot_slash(m.root)
  if m.root == "." or root == "" or (not string.contains(p, "/")) {
    p
  } else {
    match string.drop_prefix(p, root) {
      Some(rest) -> string.drop_prefix(rest, "/") ?? rest
      None -> p
    }
  }
}

fn applies(i: Indexed, is_dir: Bool) : Bool = (not i.rule.only_dir) or is_dir

fn latest(found: Option[Indexed], candidates: [Indexed], is_dir: Bool) : Option[Indexed] =
  candidates
    |> list.foldl(
      found,
      (best, c) => match best {
        Some(b) if b.index > c.index -> best
        _ -> if applies(c, is_dir) { Some(c) } else { best }
      }
    )

fn keyed(m: Map[String, [Indexed]], k: Option[String]) : [Indexed] = match k {
  Some(key) -> map.get(m, key) ?? []
  None -> []
}

# The latest rule that matches: the keyed ones match by their key; the
# others, last first, are tested until one matches.
fn decide(m: Matcher, path: String, is_dir: Bool) : Option[Indexed] {
  let s = glob.subject(path, m.general)
  let other =
    list.find(m.others, i => applies(i, is_dir) and glob.matches_subject(i.rule.pattern, s))
  let from_keys = keyed(m.whole, Some(path))
    ++ keyed(m.last, Some(s.name))
    ++ keyed(m.extensions, glob.extension(s.name))
  latest(other, from_keys, is_dir)
}

#[doc("The verdict of the last rule that matches `path`; directory-only rules match only directories.")]
pub fn matched(m: Matcher, path: String, is_dir: Bool) : Verdict =
  if m.size == 0 {
    Unmatched
  } else {
    match decide(m, relative(m, path), is_dir) {
      None -> Unmatched
      Some(i) -> if i.rule.whitelist { Whitelisted } else { Ignored }
    }
  }
