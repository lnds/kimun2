# The text of a code line as the indentation analysis reads it: its
# nesting level, and its code without literal contents or a trailing
# comment. The delimiters are ASCII, so a line is read by bytes, copying the
# runs between them whole.

import km2.lexical.bytes

const TAB_WIDTH : Int = 4

const SLASH : Int = 47

const HASH : Int = 35

const QUOTE : Int = 34

const APOSTROPHE : Int = 39

const BACKSLASH : Int = 92

fn leading(line: String, i: Int, spaces: Int) : Int = match bytes.byte(line, i) {
  32 -> leading(line, i + 1, spaces + 1)
  9 -> leading(line, i + 1, spaces + TAB_WIDTH)
  _ -> spaces
}

#[doc("The nesting level of a line: its leading spaces, a tab counting as four, in whole levels.")]
pub fn indent_depth(line: String) : Int = leading(line, 0, 0) / TAB_WIDTH

fn width_at(s: String, i: Int) : Int {
  let w = string.string_cp_len(s, i)
  if w <= 0 { 1 } else { w }
}

fn is_delimiter(b: Int) : Bool = b == SLASH or b == HASH or b == QUOTE or b == APOSTROPHE

fn plain_end(s: String, i: Int, n: Int) : Int =
  if i < n and (not is_delimiter(bytes.byte(s, i))) { plain_end(s, i + 1, n) } else { i }

# Where the string literal whose content starts at `i` closes, or past the
# end of the line.
fn string_close(s: String, i: Int, n: Int) : Int = match bytes.byte(s, i) {
  -1 -> i
  34 -> i
  92 -> string_close(s, i + 1 + width_at(s, i + 1), n)
  _ -> string_close(s, i + 1, n)
}

fn closes_at(s: String, i: Int) : Bool = bytes.byte(s, i) == APOSTROPHE

# The length of a character literal at `i` (one character, or a backslash
# and one), or 0 when none starts there.
fn char_literal(s: String, i: Int, n: Int) : Int {
  let w = width_at(s, i + 1)
  let escaped = bytes.byte(s, i + 1) == BACKSLASH
  if i + 2 >= n {
    0
  } else if closes_at(s, i + 1 + w) {
    2 + w
  } else if escaped and closes_at(s, i + 2 + width_at(s, i + 2)) {
    3 + width_at(s, i + 2)
  } else {
    0
  }
}

fn ends_line(b: Int, next: Int) : Bool =
  (b == SLASH and next == SLASH) or (b == HASH and next == 32)

# Past the delimiter at `j`: where reading goes on, and what the delimiter
# leaves of the line.
fn past(s: String, j: Int, n: Int) : (Int, String) {
  let b = bytes.byte(s, j)
  let skip = if b == APOSTROPHE { char_literal(s, j, n) } else { 0 }
  if b == QUOTE {
    (string_close(s, j + 1, n) + 1, "\"\"")
  } else if skip > 0 {
    (j + skip, "")
  } else {
    (j + 1, string.slice(s, j, 1))
  }
}

fn text_from(s: String, i: Int, n: Int, acc: [String]) : [String] {
  let j = plain_end(s, i, n)
  let kept = if j > i { [string.slice(s, i, j - i), ...acc] } else { acc }
  if j >= n or ends_line(bytes.byte(s, j), bytes.byte(s, j + 1)) {
    kept
  } else {
    let (next, piece) = past(s, j, n)
    text_from(s, next, n, [piece, ...kept])
  }
}

#[doc("A line's code, without literal contents or a trailing comment, trimmed.")]
pub fn of(line: String) : String =
  string.trim(string.join(list.reverse(text_from(line, 0, string.byte_length(line), [])), ""))
